# ── LLM Provider ──────────────────────────────────────────────────────────────
# Choose one: "sap_hyperspace" | "anthropic" | "openai"
LLM_PROVIDER=sap_hyperspace

# Model to use — pick one appropriate for the chosen provider:
#   Claude:  claude-sonnet-4-5  claude-opus-4-7  claude-haiku-4-5-20251001
#   OpenAI:  gpt-4o  gpt-4o-mini  o1-preview
LLM_MODEL_DEFAULT=claude-sonnet-4-5


# ── SAP Hyperspace AI Proxy (LLM_PROVIDER=sap_hyperspace) ─────────────────────
ANTHROPIC_BASE_URL=http://localhost:6655/anthropic/
ANTHROPIC_AUTH_TOKEN=your_sap_hyperspace_token_here


# ── Direct Anthropic (LLM_PROVIDER=anthropic) ─────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...


# ── Direct OpenAI (LLM_PROVIDER=openai) ───────────────────────────────────────
# Requires: pip install openai
# OPENAI_API_KEY=sk-...


# ── App ───────────────────────────────────────────────────────────────────────
# Single-user API key — generate any random string
API_KEY=change_me_to_a_random_secret

# SQLite database (single file, no setup required)
DATABASE_URL=sqlite:///./legal_agent.db
