# =============================================================================
# AI Legal Agent  Environment Configuration
# Copy to .env and fill in real values before running.
# NEVER commit .env to git.
# =============================================================================

#  PostgreSQL 
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=legal_automation
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/legal_automation

#  MongoDB 
MONGODB_URI=mongodb://mongodb:27017/legal_automation

#  Redis 
REDIS_URL=redis://redis:6379

#  Security (REQUIRED  change before first run) 
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-generate-a-real-secret-key-min-32-chars
JWT_ALGORITHM=HS256

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_MASTER_KEY=change-me-generate-a-real-encryption-key-32c

#  AI Provider Keys (at least one required for AI Orchestrator) 
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

#  External Service Keys (optional  set when integrations are configured) 
LEGAL_RESEARCH_API_KEY=
ESIGN_API_KEY=

#  CORS 
ALLOWED_ORIGINS=http://localhost:3000

#  Service Discovery (internal container URLs) 
NOTIFICATION_SERVICE_URL=http://notification-service:8000

#  Frontend 
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8005

#  Logging 
LOG_LEVEL=INFO
