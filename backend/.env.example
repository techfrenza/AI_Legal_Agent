# ─── App auth ────────────────────────────────────────────────────────────────
API_KEY=change-me

# ─── LLM provider ────────────────────────────────────────────────────────────
LLM_PROVIDER=sap_hyperspace          # sap_hyperspace | anthropic | openai
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=http://localhost:6655/anthropic/

# ─── Database backend ────────────────────────────────────────────────────────
# DB_BACKEND selects the database engine.
#   sqlite     (default) — local SQLite file, no extra config needed.
#   supabase   — PostgreSQL via Supabase Transaction-mode pooler.
#                Required for Vercel / serverless deployments.
DB_BACKEND=sqlite

# For DB_BACKEND=sqlite (default — leave DATABASE_URL unset to use the file below):
# DATABASE_URL=sqlite:///./legal_agent.db

# For DB_BACKEND=supabase, set DATABASE_URL to your Supabase Transaction pooler URL.
# Find it in: Supabase Dashboard → Project Settings → Database → Connection string
# Use the "Transaction mode" pooler URL (port 6543) — NOT the direct connection (port 5432).
# The transaction pooler is required for stateless/serverless runtimes like Vercel.
#
# DB_BACKEND=supabase
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
